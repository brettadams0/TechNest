# Copy to .env and adjust. Real environment variables take precedence.

# local | production | testing. Demo accounts and orders are only ever seeded
# outside production.
APP_ENV=local
# Show exception messages on error pages. Defaults to on outside production.
APP_DEBUG=
APP_TIMEZONE=America/Toronto
# Behind a reverse proxy or load balancer that terminates TLS, list its
# addresses or CIDR blocks so X-Forwarded-Proto/-For are believed: otherwise
# the session cookie loses Secure, HSTS is not sent, and every visitor shares
# the proxy's IP for login throttling. Leave empty when clients connect directly.
TRUSTED_PROXIES=

# sqlite (default, zero configuration) or mysql.
DB_DRIVER=sqlite
DB_PATH=

# Required when DB_DRIVER=mysql. There are deliberately no defaults.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
